# NetPulse QoS - Backend Environment Configuration Example
# Copy this file to .env in backend/ or set environment variables in your deployment host

# Application Metadata
APP_NAME=NetPulse QoS
APP_VERSION=1.0.0
DEBUG=false

# Server Network Binding
HOST=0.0.0.0
PORT=8000

# SQLite Persistent Database Location
# Point to a persistent mount in production (e.g. /data/netpulse.db on Render/Fly.io)
SQLITE_DB_PATH=./netpulse.db

# CORS Origins (Comma-separated or JSON array)
# Set to your deployed frontend domain in production (e.g. https://netpulse.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Probing Defaults
DEFAULT_PROBE_INTERVAL_SECONDS=5.0
DEFAULT_TIMEOUT_SECONDS=3.0
DEFAULT_CONSECUTIVE_VIOLATIONS=3
DEFAULT_AUTO_RESOLVE_COUNT=3
