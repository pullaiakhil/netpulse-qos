# ==============================================================================
# NetPulse QoS - Git Ignore Configuration
# ==============================================================================

# Node / Frontend
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
frontend/dist/
build/
*.egg-info/
.eggs/
*.tsbuildinfo

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
backend/.venv/
venv/
ENV/
env/
wheels/
develop-eggs/
downloads/
# Virtualenv lib directories (anchor to prevent ignoring frontend/src/lib)
/lib/
/lib64/
!frontend/src/lib/
!frontend/src/lib/**
sdist/
var/
.installed.cfg
*.egg

# Database (exclude all SQLite runtime databases containing local/private data)
*.db
*.sqlite
*.sqlite3
netpulse.db
backend/netpulse.db
*.db-journal
*.db-wal
*.db-shm

# C Engine compiled binaries & artifacts
c_engine/*.exe
c_engine/netpulse_engine
c_engine/*.o
c_engine/*.obj
c_engine/*.pdb
*.exe
netpulse_engine

# Environment variables & secrets (allow .env.example)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Logs & Diagnostics
*.log
logs/
*.pid

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Test & Coverage artifacts
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.pytest_cache/
backend/.pytest_cache/

# Local utility scripts
powershell.cmd
