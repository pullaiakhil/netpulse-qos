# NetPulse QoS - Frontend Environment Configuration Example
# Copy this file to .env or .env.production to configure

# Base URL for NetPulse backend API.
# - For local Vite development with dev server proxy: /api
# - For production with separate domains: https://api.yourdomain.com
# - For production reverse proxy (same domain): /api
VITE_API_BASE_URL=/api
